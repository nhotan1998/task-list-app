<div class="container mt-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0">My Task List</h1>
    <div class="d-flex gap-2">
      <%= link_to 'New Task', new_task_path, class: 'btn btn-primary' %>
    </div>
  </div>

  <%= form_with url: tasks_path, method: :get, local: true, class: 'row g-2 mb-4 align-items-end' do %>
    <div class="col-md-5">
      <%= label_tag :query, 'Search', class: 'form-label' %>
      <%= text_field_tag :query, params[:query], class: 'form-control', placeholder: 'Search by title or description' %>
    </div>

    <div class="col-md-4">
      <%= label_tag :status, 'Status', class: 'form-label' %>
      <%= select_tag :status, options_for_select([
        ['All', ''],
        ['Completed', 'completed'],
        ['Pending', 'pending'],
        ['Overdue', 'overdue'],
        ['Due Today', 'due_today']
      ], params[:status]), class: 'form-select' %>
    </div>

    <div class="col-md-3 d-flex gap-2">
      <%= submit_tag 'Filter', class: 'btn btn-outline-primary flex-fill' %>
      <%= link_to 'Clear', tasks_path, class: 'btn btn-outline-secondary flex-fill' %>
    </div>
  <% end %>

  <div class="mb-3">
    <%= link_to 'All Tasks', tasks_path, class: 'btn btn-outline-primary' %>
    <%= link_to 'Due Today', tasks_path(today: true), class: 'btn btn-outline-success' %>
  </div>

  <table class="table table-hover align-middle">
    <thead class="table-light">
      <tr>
        <th>Title</th>
        <th>Due Date</th>
        <th>Status</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% @tasks.each do |task| %>
        <tr class="<%= 'table-danger' if task.overdue? %>">
          <td>
            <strong><%= task.title %></strong><br>
            <small class="text-muted"><%= task.description.presence || 'No description' %></small>
          </td>
          <td><%= task.due_date&.strftime("%Y-%m-%d %H:%M") %></td>
          <td>
            <% if task.completed %>
              <span class="badge bg-success">Completed</span>
            <% elsif task.overdue? %>
              <span class="badge bg-danger">Overdue</span>
            <% else %>
              <span class="badge bg-warning text-dark">Pending</span>
            <% end %>
          </td>
          <td>
            <div class="d-flex gap-2 flex-wrap">
              <%= link_to 'Show', task, class: 'btn btn-sm btn-info' %>
              <%= link_to 'Edit', edit_task_path(task), class: 'btn btn-sm btn-warning' %>
              <%= form_with model: task, method: :patch, local: true, class: 'd-inline' do |f| %>
                <%= f.hidden_field :completed, value: !task.completed %>
                <%= f.submit task.completed ? 'Mark Incomplete' : 'Mark Complete', class: "btn btn-sm #{task.completed ? 'btn-outline-secondary' : 'btn-success'}" %>
              <% end %>
              <%= form_with url: task_path(task), method: :delete, local: true, html: { onsubmit: "return confirm('Are you sure you want to delete this task?');" }, class: 'd-inline' do %>
                <%= submit_tag 'Delete', class: 'btn btn-sm btn-danger' %>
              <% end %>
            </div>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
