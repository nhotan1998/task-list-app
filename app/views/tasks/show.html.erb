<div class="container mt-4" style="max-width: 600px;">
  <div class="card shadow-sm p-4">
    <h1 class="mb-4 text-info">Task Details</h1>

    <div class="mb-3">
      <strong>Title:</strong>
      <p class="fs-5"><%= @task.title %></p>
    </div>

    <div class="mb-3">
      <strong>Description:</strong>
      <p class="text-muted"><%= @task.description.presence || "No description provided." %></p>
    </div>

    <div class="mb-3">
      <strong>Due Date:</strong>
      <p><%= @task.due_date&.strftime("%Y-%m-%d %H:%M") %></p>
    </div>

    <div class="mb-3">
      <strong>Status:</strong>
      <p>
        <% if @task.completed %>
          <span class="badge bg-success">Completed</span>
        <% elsif @task.overdue? %>
          <span class="badge bg-danger">Overdue</span>
        <% else %>
          <span class="badge bg-warning">Pending</span>
        <% end %>
      </p>
    </div>

    <% unique_files = @task.unique_files %>
    <% if unique_files.any? %>
      <div class="mb-3 task-attachments">
        <strong>Attachments:</strong>
        <div class="row g-3 mt-2">
          <% unique_files.each do |file| %>
            <div class="col-md-6">
              <div class="border rounded p-2 bg-light">
                <% if file.image? %>
                  <%= image_tag file, class: 'img-fluid rounded mb-2', style: 'max-height: 180px; object-fit: cover;' %>
                <% end %>
                <div class="mt-2">
                  <%= link_to file.filename.to_s, rails_blob_path(file), target: '_blank', class: 'text-decoration-none text-truncate d-block' %>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>

    <div class="mt-4 d-flex gap-2">
      <%= link_to 'Edit', edit_task_path(@task), class: 'btn btn-warning' %>
      <%= form_with url: task_path(@task), method: :delete, local: true, html: { onsubmit: "return confirm('Are you sure you want to delete this task?');" }, class: 'd-inline' do %>
        <%= submit_tag 'Delete', class: 'btn btn-danger' %>
      <% end %>
      <%= link_to 'Back to Tasks', tasks_path, class: 'btn btn-secondary' %>
    </div>
  </div>
</div>
